<!DOCTYPE html>
<html lang="fr" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Intelligence Artificielle & Automatisation | Hozana Concept</title>
  <meta name="description" content="Solutions IA sur mesure : chatbots, agents IA, automatisation des ventes, marketing IA, prédictions data. Hozana Concept — la plateforme IA internationale. Audit gratuit 30 min.">
  <link rel="icon" type="image/png" href="images/favicon-logo.png">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Sora:wght@300;400;500;600;700;800&family=Roboto:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.4.0/css/all.min.css">
  <link rel="stylesheet" href="css/design-system.css">
  <link rel="stylesheet" href="css/components.css">
  <style>
    /* ── Page hero ── */
    .svc-page-hero {
      padding: calc(var(--nav-height) + 4rem) 2rem 4rem;
      position: relative;
      overflow: hidden;
      text-align: center;
    }
    @media(max-width:768px) { .svc-page-hero { padding: calc(var(--nav-height) + 2.5rem) 1.25rem 3rem; } }
    .svc-page-hero::before {
      content:'';
      position:absolute;
      inset:0;
      background:
        radial-gradient(ellipse 80% 60% at 50% 0%, rgba(255,46,46,0.18) 0%, transparent 60%),
        radial-gradient(ellipse 40% 40% at 85% 60%, rgba(255,106,0,0.09) 0%, transparent 55%);
    }
    .svc-page-hero::after {
      content:'';
      position:absolute;
      inset:0;
      background-image:linear-gradient(rgba(255,255,255,0.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.025) 1px,transparent 1px);
      background-size:60px 60px;
    }
    .svc-page-hero .container { position:relative;z-index:1; }

    /* ── Category label ── */
    .svc-page-cat {
      display:inline-flex;
      align-items:center;
      gap:0.5rem;
      padding:0.35rem 1rem;
      border-radius:999px;
      font-family:var(--font-accent);
      font-size:0.72rem;
      font-weight:700;
      text-transform:uppercase;
      letter-spacing:0.1em;
      background:rgba(255,46,46,0.1);
      border:1px solid rgba(255,46,46,0.25);
      color:#FF7070;
      margin-bottom:1.5rem;
    }

    /* ── Service cards grid ── */
    .svc-cards-grid {
      display:grid;
      grid-template-columns:repeat(auto-fit, minmax(320px, 1fr));
      gap:1.5rem;
      margin-top:3rem;
    }
    .svc-card-item {
      background:rgba(255,255,255,0.03);
      border:1px solid rgba(255,255,255,0.08);
      border-radius:20px;
      padding:2rem;
      transition:border-color .25s, transform .25s, background .25s;
      position:relative;
      overflow:hidden;
    }
    .svc-card-item:hover {
      border-color:rgba(255,46,46,0.3);
      background:rgba(255,46,46,0.04);
      transform:translateY(-4px);
    }
    .svc-card-item::before {
      content:'';
      position:absolute;
      top:0;left:0;right:0;
      height:2px;
      background:var(--grad-red);
      opacity:0;
      transition:opacity .25s;
    }
    .svc-card-item:hover::before { opacity:1; }

    /* Icon */
    .svc-item-icon {
      width:52px;height:52px;
      border-radius:14px;
      background:rgba(255,46,46,0.1);
      border:1px solid rgba(255,46,46,0.2);
      display:flex;align-items:center;justify-content:center;
      font-size:1.25rem;
      color:var(--red);
      margin-bottom:1.25rem;
      transition:background .25s;
    }
    .svc-card-item:hover .svc-item-icon {
      background:rgba(255,46,46,0.16);
    }
    .svc-item-title {
      font-family:var(--font-title);
      font-size:1.15rem;
      font-weight:800;
      color:var(--white);
      margin-bottom:0.75rem;
    }
    .svc-item-desc {
      font-size:0.875rem;
      color:var(--white-60);
      line-height:1.7;
      margin-bottom:1.25rem;
    }
    .svc-item-feats {
      list-style:none;
      display:flex;
      flex-direction:column;
      gap:0.45rem;
      margin-bottom:1.5rem;
    }
    .svc-item-feats li {
      display:flex;
      align-items:flex-start;
      gap:0.6rem;
      font-size:0.82rem;
      color:var(--white-70);
    }
    .svc-item-feats li i {
      font-size:0.6rem;
      color:var(--red);
      margin-top:0.35em;
      flex-shrink:0;
    }
    .svc-item-cta {
      font-family:var(--font-accent);
      font-size:0.82rem;
      font-weight:700;
      color:var(--red);
      text-decoration:none;
      display:inline-flex;
      align-items:center;
      gap:0.4rem;
      transition:gap .2s;
    }
    .svc-item-cta:hover { gap:0.65rem; }

    /* ── Process section ── */
    .process-steps {
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
      gap:1.25rem;
      margin-top:3rem;
    }
    .process-step {
      text-align:center;
      padding:2rem 1.5rem;
      background:rgba(255,255,255,0.02);
      border:1px solid rgba(255,255,255,0.07);
      border-radius:16px;
      position:relative;
    }
    .process-step-num {
      font-family:var(--font-title);
      font-size:3rem;
      font-weight:900;
      background:var(--grad-red);
      -webkit-background-clip:text;
      -webkit-text-fill-color:transparent;
      line-height:1;
      margin-bottom:0.75rem;
    }
    .process-step-title {
      font-family:var(--font-accent);
      font-size:0.9rem;
      font-weight:700;
      color:var(--white-90);
      margin-bottom:0.5rem;
    }
    .process-step-desc {
      font-size:0.8rem;
      color:var(--white-50);
      line-height:1.6;
    }

    /* ── CTA ── */
    .svc-page-cta {
      position:relative;overflow:hidden;
      background:linear-gradient(135deg,rgba(255,46,46,0.09),rgba(255,106,0,0.06));
      border:1px solid rgba(255,46,46,0.15);
      border-radius:24px;
      padding:5rem 3rem;
      text-align:center;
      margin:0;
    }
    .svc-page-cta::before {
      content:'';position:absolute;inset:0;
      background-image:linear-gradient(rgba(255,255,255,0.025) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.025) 1px,transparent 1px);
      background-size:40px 40px;pointer-events:none;
    }
    .svc-page-cta::after {
      content:'';position:absolute;top:0;left:50%;transform:translateX(-50%);
      width:50%;height:1px;background:var(--grad-red);opacity:.7;
    }
    .svc-page-cta > * { position:relative;z-index:1; }

    /* Results metrics */
    .results-row {
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
      gap:1rem;
      margin-top:3rem;
    }
    .result-metric {
      padding:1.5rem 1rem;
      background:rgba(255,255,255,0.03);
      border:1px solid rgba(255,255,255,0.07);
      border-radius:16px;
      text-align:center;
    }
    .result-metric-val {
      font-family:var(--font-title);
      font-size:2.2rem;
      font-weight:900;
      background:var(--grad-red);
      -webkit-background-clip:text;
      -webkit-text-fill-color:transparent;
      line-height:1;
      margin-bottom:0.5rem;
    }
    .result-metric-lbl {
      font-size:0.78rem;
      color:var(--white-50);
      font-family:var(--font-accent);
    }

    @media(max-width:768px) {
      .svc-cards-grid { grid-template-columns:1fr; }
      .svc-page-cta { padding:3rem 1.5rem; }
    }
  </style>
</head>
